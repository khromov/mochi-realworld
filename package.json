{
  "name": "mochi-realworld",
  "private": true,
  "type": "module",
  "engines": {
    "bun": ">=1.3.14"
  },
  "scripts": {
    "build": "mochi-framework build",
    "start": "bun src/index.ts",
    "dev": "MODE=development bun src/index.ts",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --compiler-warnings 'attribute_illegal_colon:ignore' && tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "clean": "rimraf .mochi"
  },
  "dependencies": {
    "@fontsource/source-sans-pro": "^5.3.0",
    "@fontsource/source-serif-pro": "^5.3.0",
    "@fontsource/titillium-web": "^5.3.0",
    "marked": "^18.0.9",
    "mochi-framework": "file:./vendor/mochi/packages/mochi",
    "sanitize-html": "^2.17.6",
    "svelte": "^5.56.8"
  },
  "devDependencies": {
    "@types/bun": "1.3.14",
    "@types/sanitize-html": "^2.16.1",
    "svelte-check": "4.7.4",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "msgpackr-extract": "npm:@mochi-framework/msgpackr-extract-stub@*"
  },
  "patchedDependencies": {
    "svelte-check@4.7.4": "patches/svelte-check@4.7.4.patch"
  }
}
